{
  "name": "music-dna-player",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "service": ".venv/bin/python -m uvicorn musicdna.service.app:app --host 127.0.0.1 --port 8765 --reload --reload-dir musicdna",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/project.test.mjs && node --experimental-strip-types --test tests/core.test.mjs",
    "test:model": "node --experimental-strip-types --test tests/personalize.test.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "wavesurfer.js": "^8.0.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=20.19"
  }
}
